# ── Banco de dados ─────────────────────────────────────────────────────────────
# Produção (Supabase/PostgreSQL): preencha DATABASE_URL.
# Sem DATABASE_URL, o app usa PGlite (Postgres embutido) persistindo em .data/.
# DATABASE_URL=postgresql://postgres:SENHA@db.xxxxx.supabase.co:5432/postgres

# ── Inteligência artificial (server-only) ──────────────────────────────────────
# Endpoint compatível com OpenAI. Também funciona com Gemini (endpoint
# OpenAI-compatible https://generativelanguage.googleapis.com/v1beta/openai/)
# e com Groq/DeepSeek/OpenRouter (troque OPENAI_BASE_URL e OPENAI_MODEL).
# Sem chave, o app funciona com classificação MANUAL e aviso honesto de que a
# análise automática está indisponível (nunca simula resultado de IA).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Central de Mobilização ─────────────────────────────────────────────────────
# Token de acesso administrativo (mínimo 16 caracteres). As rotas administrativas
# validam este token NO SERVIDOR — não é apenas ocultação de botões.
ADMIN_TOKEN=troque-por-um-token-longo-e-secreto

# ── Público ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://rede-solidaria.vercel.app
